---
// EXA Región Centro Landing Page
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html class="scroll-smooth" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="description" content="EXA Región Centro 2026: Primera expo B2B que integra Industria, Comercio, Hidrovía, Fintech y Agro. Septiembre 2026, Parque Industrial San Lorenzo, Santa Fe. +20.000m² de exhibición, networking de alto nivel y oportunidades de negocio para empresas de la región centro." />
    <title>
      EXA Región Centro | Primera Expo Industrial, Comercial e Hidrovía
    </title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      .hero-overlay {
        background: linear-gradient(
          to bottom,
          rgba(26, 54, 93, 0.4),
          rgba(26, 54, 93, 0.6)
        );
      }
      .vibrant-gradient-text {
        background: linear-gradient(135deg, #ffffff 0%, #ff6b00 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .bg-pattern-circles {
        background-image: radial-gradient(
          circle at 2px 2px,
          rgba(255, 107, 0, 0.1) 1px,
          transparent 0
        );
        background-size: 24px 24px;
      }
      .curve-decoration {
        border-radius: 50%;
        position: absolute;
      }
    </style>
  </head>
  <body
    class="bg-white dark:bg-background-dark text-slate-900 dark:text-slate-100 transition-colors duration-300 overflow-x-hidden"
  >
    <Header />
    <section
      class="relative min-h-screen flex items-center justify-center overflow-hidden"
      id="hero"
    >
      <div
        class="absolute -top-24 -right-24 w-[500px] h-[500px] bg-secondary opacity-10 curve-decoration"
      >
      </div>
      <div
        class="absolute -bottom-48 -left-48 w-[600px] h-[600px] bg-primary opacity-20 curve-decoration"
      >
      </div>
      <!-- Video Background -->
      <div class="absolute inset-0 z-0">
        <video
          autoplay
          loop
          muted
          playsinline
          class="w-full h-full object-cover"
        >
          <source src="https://assets.exaferia.com/video-header.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 hero-overlay"></div>
      </div>
      <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-20">
        <div
          class="inline-flex items-center px-5 py-2 rounded-full bg-secondary text-white text-xs font-black mb-10 tracking-widest uppercase"
        >
          <span class="relative flex h-2 w-2 mr-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-white"
            ></span>
          </span>
          Septiembre 2026 · Parque Industrial · San Lorenzo
        </div>
        <!-- Logo EXA en lugar de texto -->
        <div class="flex justify-center mb-6">
          <img src="/images/logo-exa.png" alt="EXA Región Centro" class="h-32 md:h-48" />
        </div>
        <h2
          class="text-3xl md:text-5xl font-extrabold text-white mb-10 leading-tight"
        >
          Primera Expo <span class="text-secondary">Industrial, Agro, Fintech, Comercial e Hidrovía</span> de la Región Centro.
        </h2>
        <div
          class="flex flex-col md:flex-row items-center justify-center gap-6"
        >
          <a
            class="w-full md:w-auto px-12 py-5 bg-secondary hover:bg-orange-600 text-white rounded-2xl text-xl font-black shadow-2xl shadow-secondary/40 transition-all transform hover:scale-105"
            href="#contact"
          >
            Quiero ser expositor
          </a>
          <a
            class="w-full md:w-auto px-12 py-5 bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border-2 border-white/20 rounded-2xl text-xl font-bold transition-all"
            href="#about"
          >
            Saber más
          </a>
        </div>
      </div>
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
        <span class="material-symbols-outlined text-white/50 text-4xl"
          >keyboard_double_arrow_down</span
        >
      </div>
    </section>
    <section class="py-32 relative bg-white dark:bg-slate-900" id="about">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-20 items-center">
          <div class="relative">
            <div
              class="absolute -top-10 -left-10 w-full h-full border-4 border-secondary/20 rounded-5xl -z-10"
            >
            </div>
            <div
              class="relative overflow-hidden rounded-4xl shadow-2xl aspect-square"
            >
                <img
                  alt="EXA Región Centro"
                  class="w-full h-full object-cover"
                  src="/images/expo-1.png"
                />
              <div class="absolute inset-0 bg-primary/20"></div>
            </div>
            <div
              class="absolute -bottom-10 -right-10 w-40 h-40 bg-secondary rounded-full flex items-center justify-center text-white p-6 text-center leading-tight font-black rotate-12 shadow-xl"
            >
              SÉ PARTE DE EXA
            </div>
          </div>
          <div>
            <div class="w-20 h-1.5 bg-secondary mb-8 rounded-full"></div>
            <h3
              class="text-secondary font-black tracking-[0.3em] uppercase mb-4 text-sm"
            >
              La nueva exposición
            </h3>
            <h2
              class="text-5xl md:text-6xl font-black text-primary dark:text-white mb-8 leading-tight"
            >
              Un evento que <span class="text-secondary">transforma</span> la visión industrial
            </h2>
            <p
              class="text-xl text-slate-600 dark:text-slate-400 mb-10 leading-relaxed font-medium"
            >
              EXA nace para unir a los protagonistas del desarrollo productivo, impulsar vínculos estratégicos, generar oportunidades de negocio y proyectar el futuro de la región. Un espacio creado para <strong>conectar, innovar y crecer</strong>, donde empresas e instituciones se encuentran para construir relaciones de largo plazo.
            </p>
            <p
              class="text-lg text-slate-600 dark:text-slate-400 mb-10 leading-relaxed font-medium"
            >
              Explore la fuerza del campo con tecnologías del futuro, encuentre la agilidad financiera para su empresa y el impulso que su negocio necesita, potenciando su alcance con la hidrovía.
            </p>
            <div class="grid grid-cols-2 gap-12 pt-8">
              <div class="border-l-4 border-secondary pl-6">
                <span
                  class="block text-5xl font-black text-primary dark:text-white"
                  >+20.000</span
                >
                <span
                  class="text-sm font-bold text-slate-500 uppercase tracking-widest"
                  >m² Exposición</span
                >
              </div>
              <div class="border-l-4 border-secondary pl-6">
                <span
                  class="block text-5xl font-black text-primary dark:text-white"
                  >+200</span
                >
                <span
                  class="text-sm font-bold text-slate-500 uppercase tracking-widest"
                  >Stands Confirmados</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section
      class="py-32 bg-slate-50 dark:bg-slate-950 relative overflow-hidden"
      id="sectors"
    >
      <div
        class="absolute top-0 right-0 w-[800px] h-[800px] bg-primary/5 rounded-full -mr-[400px] -mt-[400px]"
      >
      </div>
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
          <h2
            class="text-4xl md:text-6xl font-black text-primary dark:text-white mb-6"
          >
            Ejes Temáticos
          </h2>
          <p
            class="text-slate-500 dark:text-slate-400 font-bold tracking-widest uppercase"
          >
            Ecosistema productivo integral
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div
            class="group bg-white dark:bg-slate-900 p-12 rounded-[2.5rem] border-2 border-transparent hover:border-secondary transition-all duration-500 shadow-xl shadow-slate-200/50 dark:shadow-none"
          >
            <div
              class="w-20 h-20 bg-primary/10 rounded-3xl flex items-center justify-center mb-8 text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500"
            >
              <span class="material-symbols-outlined text-4xl font-light"
                >factory</span
              >
            </div>
            <h4 class="text-3xl font-black mb-4 dark:text-white">Industria</h4>
            <p
              class="text-slate-500 dark:text-slate-400 leading-relaxed text-lg"
            >
              Innovación en manufactura, maquinaria, automatización y procesos productivos que impulsan la industria 4.0.
            </p>
          </div>
          <div
            class="group bg-white dark:bg-slate-900 p-12 rounded-[2.5rem] border-2 border-transparent hover:border-secondary transition-all duration-500 shadow-xl shadow-slate-200/50 dark:shadow-none"
          >
            <div
              class="w-20 h-20 bg-primary/10 rounded-3xl flex items-center justify-center mb-8 text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500"
            >
              <span class="material-symbols-outlined text-4xl font-light"
                >storefront</span
              >
            </div>
            <h4 class="text-3xl font-black mb-4 dark:text-white">Comercio</h4>
            <p
              class="text-slate-500 dark:text-slate-400 leading-relaxed text-lg"
            >
              Empresas, pymes y servicios B2B que integran y fortalecen la cadena de valor regional, desde el comercio hasta la logística avanzada.
            </p>
          </div>
          <div
            class="group bg-white dark:bg-slate-900 p-12 rounded-[2.5rem] border-2 border-transparent hover:border-secondary transition-all duration-500 shadow-xl shadow-slate-200/50 dark:shadow-none"
          >
            <div
              class="w-20 h-20 bg-primary/10 rounded-3xl flex items-center justify-center mb-8 text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500"
            >
              <span class="material-symbols-outlined text-4xl font-light"
                >directions_boat</span
              >
            </div>
            <h4 class="text-3xl font-black mb-4 dark:text-white">Hidrovía</h4>
            <p
              class="text-slate-500 dark:text-slate-400 leading-relaxed text-lg"
            >
              El sistema fluvial más importante de Argentina: puertos, logística, dragado, transporte y servicios estratégicos para el comercio exterior.
            </p>
          </div>
          <div
            class="group bg-white dark:bg-slate-900 p-12 rounded-[2.5rem] border-2 border-transparent hover:border-secondary transition-all duration-500 shadow-xl shadow-slate-200/50 dark:shadow-none"
          >
            <div
              class="w-20 h-20 bg-primary/10 rounded-3xl flex items-center justify-center mb-8 text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500"
            >
              <span class="material-symbols-outlined text-4xl font-light"
                >account_balance_wallet</span
              >
            </div>
            <h4 class="text-3xl font-black mb-4 dark:text-white">Fintech</h4>
            <p
              class="text-slate-500 dark:text-slate-400 leading-relaxed text-lg"
            >
              Soluciones financieras de última generación para empresas: pagos, financiamiento, tecnología aplicada y nuevos modelos de negocio.
            </p>
          </div>
          <div
            class="group bg-white dark:bg-slate-900 p-12 rounded-[2.5rem] border-2 border-transparent hover:border-secondary transition-all duration-500 shadow-xl shadow-slate-200/50 dark:shadow-none md:col-span-2"
          >
            <div class="flex flex-col md:flex-row md:items-center gap-8">
              <div
                class="w-20 h-20 shrink-0 bg-primary/10 rounded-3xl flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500"
              >
                <span class="material-symbols-outlined text-4xl font-light"
                  >agriculture</span
                >
              </div>
              <div>
                <h4 class="text-3xl font-black mb-4 dark:text-white">Agro</h4>
                <p
                  class="text-slate-500 dark:text-slate-400 leading-relaxed text-lg"
                >
                  La fuerza del campo con tecnología del futuro: agtech, innovación y maquinaria agrícola de vanguardia al servicio de la producción.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="py-32 relative bg-primary overflow-hidden" id="location">
      <div class="absolute inset-0 bg-pattern-circles opacity-20"></div>
      <div
        class="absolute -top-24 -left-24 w-96 h-96 bg-secondary opacity-30 rounded-full blur-3xl"
      >
      </div>
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-20 items-center">
          <div>
            <span
              class="inline-block px-5 py-2 bg-secondary text-white font-black text-xs uppercase tracking-[0.2em] rounded-full mb-8"
              >Ubicación Estratégica</span
            >
            <h2
              class="text-5xl md:text-6xl font-black text-white mb-8 leading-tight"
            >
              Parque Industrial <br />San Lorenzo
            </h2>
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center shrink-0 mt-1"
                >
                  <span class="material-symbols-outlined text-secondary"
                    >location_on</span
                  >
                </div>
                <p class="text-2xl font-bold text-white">
                  Ubicado estratégicamente sobre la autopista Rosario-Santa Fe.
                </p>
              </div>
              <p class="text-xl text-slate-300 leading-relaxed">
                Un predio de excelencia con accesos rápidos y toda la
                infraestructura necesaria para el desarrollo de una exposición
                de gran escala en el corazón del litoral argentino.
              </p>
            </div>
          </div>
          <div class="relative">
            <div
              class="rounded-4xl overflow-hidden border-8 border-white/10 shadow-3xl aspect-[4/3] relative group"
            >
              <iframe
                allowfullscreen=""
                class="w-full h-full grayscale hover:grayscale-0 transition-all duration-700"
                loading="lazy"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d26504.827074774964!2d-60.7739264965365!3d-32.72668370037746!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95b644b4633cb3a3%3A0x48ea71c3a1e22397!2sParque%20Industrial%20San%20Lorenzo!5e0!3m2!1ses-419!2sar!4v1769567319068!5m2!1ses-419!2sar"
                style="border:0;"></iframe>
            </div>
            <div
              class="absolute -bottom-6 -right-6 w-32 h-32 bg-secondary rounded-full border-4 border-primary z-20 flex items-center justify-center"
            >
              <span class="material-symbols-outlined text-white text-5xl"
                >route</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Event Structure Section -->
    <section class="py-32 bg-slate-50 dark:bg-slate-950" id="event-structure">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-20">
          <h3
            class="text-secondary font-black tracking-[0.3em] uppercase mb-4 text-sm"
          >
            Estructura del Evento
          </h3>
          <h2
            class="text-4xl md:text-6xl font-black text-primary dark:text-white mb-6"
          >
            Experiencia completa para <span class="text-secondary">expositores y visitantes</span>
          </h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border-2 border-slate-100 dark:border-slate-800 hover:border-secondary/30 transition-all">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary text-3xl">storefront</span>
              <div>
                <h4 class="text-xl font-black mb-2 dark:text-white">Stands de industria, comercio y servicios</h4>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border-2 border-slate-100 dark:border-slate-800 hover:border-secondary/30 transition-all">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary text-3xl">directions_boat</span>
              <div>
                <h4 class="text-xl font-black mb-2 dark:text-white">Sector hidrovial y logístico</h4>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border-2 border-slate-100 dark:border-slate-800 hover:border-secondary/30 transition-all">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary text-3xl">laptop</span>
              <div>
                <h4 class="text-xl font-black mb-2 dark:text-white">Espacios para fintech y agro</h4>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border-2 border-slate-100 dark:border-slate-800 hover:border-secondary/30 transition-all">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary text-3xl">forum</span>
              <div>
                <h4 class="text-xl font-black mb-2 dark:text-white">Charlas, foros y presentaciones</h4>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border-2 border-slate-100 dark:border-slate-800 hover:border-secondary/30 transition-all">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary text-3xl">handshake</span>
              <div>
                <h4 class="text-xl font-black mb-2 dark:text-white">Rondas de negocios y networking de alto nivel</h4>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border-2 border-slate-100 dark:border-slate-800 hover:border-secondary/30 transition-all">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary text-3xl">school</span>
              <div>
                <h4 class="text-xl font-black mb-2 dark:text-white">Área institucional y académica</h4>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border-2 border-slate-100 dark:border-slate-800 hover:border-secondary/30 transition-all">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary text-3xl">restaurant</span>
              <div>
                <h4 class="text-xl font-black mb-2 dark:text-white">Food Park y propuestas gastronómicas</h4>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border-2 border-slate-100 dark:border-slate-800 hover:border-secondary/30 transition-all md:col-span-2">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary text-3xl">celebration</span>
              <div>
                <h4 class="text-xl font-black mb-2 dark:text-white">Show de cierre</h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-32 bg-white dark:bg-slate-900" id="services">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-20 items-center">
          <div>
            <h3
              class="text-secondary font-black tracking-[0.3em] uppercase mb-4 text-sm"
            >
              Servicios Integrales
            </h3>
            <h2
              class="text-5xl md:text-6xl font-black text-primary dark:text-white mb-8 leading-tight"
            >
              Llave en mano: <span class="text-secondary">todo listo</span> para su éxito
            </h2>
            <p
              class="text-xl text-slate-600 dark:text-slate-400 mb-10 leading-relaxed"
            >
              Ofrecemos un servicio de diseño integral y montaje de stand, pensado para quienes buscan presencia profesional sin preocuparse por la logística o la producción. Incluye el desarrollo completo del stand: desde el concepto y diseño visual hasta la fabricación, montaje y asistencia técnica durante la feria.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-6">
            <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-3xl border-2 border-slate-100 dark:border-slate-800">
              <span class="material-symbols-outlined text-secondary text-4xl mb-4 block">campaign</span>
              <h4 class="font-black text-lg mb-2 dark:text-white">Cartelería</h4>
              <p class="text-sm text-slate-500 dark:text-slate-400">Interior y perimetral</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-3xl border-2 border-slate-100 dark:border-slate-800">
              <span class="material-symbols-outlined text-secondary text-4xl mb-4 block">tv</span>
              <h4 class="font-black text-lg mb-2 dark:text-white">Pantallas LED</h4>
              <p class="text-sm text-slate-500 dark:text-slate-400">Alta definición</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-3xl border-2 border-slate-100 dark:border-slate-800">
              <span class="material-symbols-outlined text-secondary text-4xl mb-4 block">description</span>
              <h4 class="font-black text-lg mb-2 dark:text-white">Folletería</h4>
              <p class="text-sm text-slate-500 dark:text-slate-400">Diseño y producción</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-3xl border-2 border-slate-100 dark:border-slate-800">
              <span class="material-symbols-outlined text-secondary text-4xl mb-4 block">language</span>
              <h4 class="font-black text-lg mb-2 dark:text-white">Digital</h4>
              <p class="text-sm text-slate-500 dark:text-slate-400">Web, RRSS, IA</p>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-3xl border-2 border-slate-100 dark:border-slate-800 col-span-2">
              <span class="material-symbols-outlined text-secondary text-4xl mb-4 block">shopping_bag</span>
              <h4 class="font-black text-lg mb-2 dark:text-white">Merchandising</h4>
              <p class="text-sm text-slate-500 dark:text-slate-400">Productos personalizados para su marca</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-32 bg-white dark:bg-slate-900" id="benefits">
      <div class="max-w-7xl mx-auto px-6">
        <div
          class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8"
        >

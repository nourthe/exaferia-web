---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "EXA Región Centro | Primera Expo Industrial, Comercial e Hidrovía",
  description = "EXA Región Centro 2026: La primera expo que integra Industria, Comercio, Hidrovía, Fintech y Agro. Septiembre 2026 en Parque Industrial San Lorenzo, Santa Fe. Networking, visibilidad y negocios B2B para empresas de la región centro.",
  image = "/og-image.png",
  url = Astro.url
} = Astro.props;

// Keywords for SEO
const keywords = "expo, feria, B2B, industria, comercio, hidrovía, fintech, agro, región centro, santa fe, san lorenzo, networking, expositores, stands, 2026";

// Open Graph specific content
const ogTitle = "EXA Región Centro | Expo Industrial 2026";
const ogDescription = "Primera Expo Industrial, Agro, Fintech, Comercial e Hidrovía de la Región Centro. Septiembre 2026, San Lorenzo, Santa Fe.";
const siteName = "EXA Región Centro";
const locale = "es_AR";

// No Twitter account available — omit twitter:site. Use Instagram in JSON-LD sameAs instead.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={url} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    
    <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <!-- No twitter:site since there is no Twitter account for the brand -->
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={image} />
    
    <!-- Fonts -->
    <link rel="stylesheet" href="/styles/fonts.css" />
    
    <!-- Structured data for EXA event -->
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Event",
        "name": "EXA Región Centro",
        "description": ogDescription,
        "startDate": "2026-09",
        "location": {
          "@type": "Place",
          "name": "Parque Industrial San Lorenzo",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "San Lorenzo",
            "addressRegion": "Santa Fe",
            "addressCountry": "AR"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": siteName,
          "url": "https://exaferia.com",
          "email": "info@exaferia.com"
        }
      })}
    </script>

    <style is:global>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      .logo {
        max-width: 200px;
        width: 100%;
        height: auto;
        margin: 2rem auto 0;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>

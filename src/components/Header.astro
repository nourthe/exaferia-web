---
// EXA Región Centro - Header Component
---

<nav
  class="fixed w-full z-50 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-100 dark:border-slate-800"
>
  <div
    class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between"
  >
    <div class="flex items-center space-x-2">
      <img src="/images/logo-exa.png" alt="EXA Región Centro" class="h-12" />
      <div class="flex flex-col">
        <span
          class="text-xs font-extrabold tracking-wider text-slate-500 dark:text-slate-400 uppercase leading-none"
          >Expo Argentina</span
        >
        <span
          class="text-2xl font-extrabold tracking-tighter text-primary dark:text-white flex items-center leading-none"
        >
          E<span class="text-secondary">X</span>A
          <span class="text-xs ml-2 font-bold text-slate-400">2026</span>
        </span>
      </div>
    </div>
    <div class="hidden md:flex items-center space-x-8 text-sm font-bold">
      <a class="hover:text-secondary transition-colors" href="#">Inicio</a>
      <a class="hover:text-secondary transition-colors" href="#contact"
        >Contacto</a
      >
      <a
        class="bg-secondary text-white px-7 py-3 rounded-full hover:bg-orange-600 transition-all shadow-lg shadow-secondary/20"
        href="#contact">Quiero ser expositor</a
      >
    </div>
  </div>
</nav>
